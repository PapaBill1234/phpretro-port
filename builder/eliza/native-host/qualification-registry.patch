+// ---------------------------------------------------------------------------
+// Native text-host qualification (source-level, unbuilt here).
+//
+// The reviewed startup patch makes the production manager capture an empty
+// `ToolPolicy` ceiling. A registry built from that *captured* policy must reject
+// every registration class (trusted, prepended, external, and every exposure)
+// and must not invoke any handler while doing so. No turn is submitted and no
+// model/account/network call is made.
+// ---------------------------------------------------------------------------
+
+async fn nr_captured_policy_session() -> (tempfile::TempDir, ThreadManager, NewThread) {
+    let temp_dir = tempdir().expect("tempdir");
+    let mut config = test_config().await;
+    config.codex_home = temp_dir.path().join("codex-home").abs();
+    config.cwd = config.codex_home.abs();
+    std::fs::create_dir_all(&config.codex_home).expect("create codex home");
+    let manager = ThreadManager::with_models_provider_and_home_for_tests(
+        CodexAuth::from_api_key("dummy"),
+        config.model_provider.clone(),
+        config.codex_home.to_path_buf(),
+        Arc::new(codex_exec_server::EnvironmentManager::default_for_tests()),
+    );
+    let started = manager
+        .start_thread(StartThreadOptions::new(config))
+        .await
+        .expect("start qualification thread");
+    (temp_dir, manager, started)
+}
+
+/// A tool handler that counts how often it is invoked.
+struct QualificationCountingHandler {
+    tool_name: codex_tools::ToolName,
+    invocations: Arc<AtomicUsize>,
+}
+
+impl ToolExecutor<ToolInvocation> for QualificationCountingHandler {
+    fn tool_name(&self) -> codex_tools::ToolName {
+        self.tool_name.clone()
+    }
+
+    fn spec(&self) -> codex_tools::ToolSpec {
+        test_spec(&self.tool_name)
+    }
+
+    fn handle<'a>(&'a self, _invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        let invocations = Arc::clone(&self.invocations);
+        Box::pin(async move {
+            invocations.fetch_add(1, Ordering::SeqCst);
+            Ok(
+                Box::new(crate::tools::context::FunctionToolOutput::from_text(
+                    "ok".to_string(),
+                    Some(true),
+                )) as Box<dyn crate::tools::context::ToolOutput>,
+            )
+        })
+    }
+}
+
+impl CoreToolRuntime for QualificationCountingHandler {}
+
+fn nr_counting_handler(name: &str, invocations: &Arc<AtomicUsize>) -> Arc<dyn CoreToolRuntime> {
+    Arc::new(QualificationCountingHandler {
+        tool_name: codex_tools::ToolName::plain(name),
+        invocations: Arc::clone(invocations),
+    })
+}
+
+#[tokio::test]
+async fn native_text_host_qualification_captured_policy_rejects_registration() {
+    let (_temp_dir, _manager, started) = nr_captured_policy_session().await;
+    let policy = Arc::clone(&started.thread.session.tool_policy);
+    assert_eq!(
+        policy.allowed_tools.as_ref().map(Vec::len),
+        Some(0),
+        "manager-started session must capture the empty ceiling"
+    );
+
+    let invocations = Arc::new(AtomicUsize::new(0));
+    let mut registry = ToolRegistry::with_tool_policy(policy);
+
+    registry.register_trusted(nr_counting_handler(
+        "qualification_trusted",
+        &invocations,
+    ));
+    registry.prepend_trusted(nr_counting_handler(
+        "qualification_prepended",
+        &invocations,
+    ));
+    registry.register_trusted_with_exposure(
+        nr_counting_handler("qualification_hidden", &invocations),
+        ToolExposure::Hidden,
+    );
+    registry.register_trusted_with_exposure(
+        nr_counting_handler("qualification_deferred", &invocations),
+        ToolExposure::Deferred,
+    );
+    registry.register_trusted_with_exposure(
+        nr_counting_handler("qualification_codemode", &invocations),
+        ToolExposure::CodeModeOnly,
+    );
+    registry.register_trusted_with_exposure(
+        nr_counting_handler("qualification_direct_model_only", &invocations),
+        ToolExposure::DirectModelOnly,
+    );
+    let external_accepted = registry.register_external(nr_counting_handler(
+        "qualification_external",
+        &invocations,
+    ));
+    registry.register_external_with_exposure(
+        nr_counting_handler("qualification_external_hidden", &invocations),
+        ToolExposure::Hidden,
+    );
+
+    assert_eq!(
+        registry.entries().count(),
+        0,
+        "the captured empty ceiling must reject every registration"
+    );
+    assert!(
+        !external_accepted,
+        "external registration must be rejected under the empty ceiling"
+    );
+    assert_eq!(
+        invocations.load(Ordering::SeqCst),
+        0,
+        "no handler may be invoked while registering"
+    );
+
+    started
+        .thread
+        .shutdown_and_wait()
+        .await
+        .expect("shut down qualification thread");
+}
