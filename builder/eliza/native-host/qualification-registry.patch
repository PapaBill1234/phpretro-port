+// ---------------------------------------------------------------------------
+// Native text-host qualification (source-level, unbuilt here).
+//
+// The reviewed startup patch makes the production manager capture an empty
+// `ToolPolicy` ceiling for every session. These tests take a session created by
+// the real `ThreadManager`, build the production tool router with
+// `build_tool_router` (which finalizes the registry under that captured policy),
+// and assert the finalized plan is completely empty: no complete registry
+// entries, model-visible specs, namespace inventory, code-mode nested names, or
+// exposed tools. No turn is submitted and no model/account/network call is made.
+// ---------------------------------------------------------------------------
+
+async fn nr_start_qualification_thread(
+    configure: impl FnOnce(&mut StartThreadOptions),
+) -> (tempfile::TempDir, ThreadManager, NewThread) {
+    let temp_dir = tempdir().expect("tempdir");
+    let mut config = test_config().await;
+    config.codex_home = temp_dir.path().join("codex-home").abs();
+    config.cwd = config.codex_home.abs();
+    std::fs::create_dir_all(&config.codex_home).expect("create codex home");
+    let manager = ThreadManager::with_models_provider_and_home_for_tests(
+        CodexAuth::from_api_key("dummy"),
+        config.model_provider.clone(),
+        config.codex_home.to_path_buf(),
+        Arc::new(codex_exec_server::EnvironmentManager::default_for_tests()),
+    );
+    let mut options = StartThreadOptions::new(config);
+    configure(&mut options);
+    let started = manager
+        .start_thread(options)
+        .await
+        .expect("start qualification thread");
+    (temp_dir, manager, started)
+}
+
+fn nr_assert_empty_tool_router(router: &ToolRouter) {
+    assert!(
+        router.model_visible_specs().is_empty(),
+        "finalized plan must expose zero model-visible specs"
+    );
+    assert!(
+        router.registered_tool_names_for_test().is_empty(),
+        "finalized registry must contain zero complete entries"
+    );
+    assert!(
+        router.tool_namespaces_info().is_none(),
+        "finalized plan must expose no namespace inventory"
+    );
+    assert!(
+        router.code_mode_tool_names().is_empty(),
+        "finalized plan must expose zero code-mode nested names"
+    );
+    for name in [
+        "exec_command",
+        "write_stdin",
+        "view_image",
+        "apply_patch",
+        "update_plan",
+        "web_search",
+    ] {
+        assert!(
+            !router.exposes_tool(&ToolName::plain(name)),
+            "tool `{name}` must not be exposed under the empty ceiling"
+        );
+    }
+}
+
+#[tokio::test]
+async fn native_text_host_qualification_manager_started_registry_is_empty() {
+    let (_temp_dir, _manager, started) = nr_start_qualification_thread(|_| {}).await;
+    let session = Arc::clone(&started.thread.session);
+
+    let turn = session.new_default_turn().await;
+    let step_context = StepContext::for_test(Arc::clone(&turn));
+    let router = super::build_tool_router(
+        &session,
+        step_context.turn.as_ref(),
+        &step_context.settings.model_info,
+        &step_context.environments,
+        &step_context.mcp,
+        /*apps_enabled*/ false,
+        &turn.extension_data,
+        /*tool_suggest_candidates*/ None,
+    )
+    .expect("build tool router under captured empty ceiling");
+
+    nr_assert_empty_tool_router(&router);
+
+    started
+        .thread
+        .shutdown_and_wait()
+        .await
+        .expect("shut down qualification thread");
+}
+
+#[tokio::test]
+async fn native_text_host_qualification_manager_started_registry_rejects_dynamic_tools() {
+    let (_temp_dir, _manager, started) = nr_start_qualification_thread(|_| {}).await;
+    let session = Arc::clone(&started.thread.session);
+
+    let mut turn = session.new_default_turn().await;
+    {
+        let turn = Arc::get_mut(&mut turn).expect("fresh turn context is unshared");
+        turn.dynamic_tools.push(dynamic_tool(
+            None,
+            "qualification_dynamic_fn",
+            /*defer_loading*/ false,
+        ));
+        turn.dynamic_tools.push(dynamic_tool(
+            Some("qualification_ns"),
+            "qualification_nested_fn",
+            /*defer_loading*/ true,
+        ));
+    }
+    let step_context = StepContext::for_test(Arc::clone(&turn));
+    let router = super::build_tool_router(
+        &session,
+        step_context.turn.as_ref(),
+        &step_context.settings.model_info,
+        &step_context.environments,
+        &step_context.mcp,
+        /*apps_enabled*/ false,
+        &turn.extension_data,
+        /*tool_suggest_candidates*/ None,
+    )
+    .expect("build tool router with adversarial dynamic contributions");
+
+    nr_assert_empty_tool_router(&router);
+    assert!(
+        !router.exposes_tool(&ToolName::plain("qualification_dynamic_fn")),
+        "adversarial dynamic function tool must not be exposed"
+    );
+    assert!(
+        !router.exposes_tool(&ToolName::new(
+            Some("qualification_ns".to_string()),
+            "qualification_nested_fn",
+        )),
+        "adversarial dynamic namespaced tool must not be exposed"
+    );
+
+    started
+        .thread
+        .shutdown_and_wait()
+        .await
+        .expect("shut down qualification thread");
+}
