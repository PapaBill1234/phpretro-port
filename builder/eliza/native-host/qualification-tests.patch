+#[tokio::test]
+async fn native_text_host_qualification_legacy_fork_is_covered() {
+    let (_temp_dir, manager, config) = qh_manager().await;
+    let root = manager
+        .start_thread(StartThreadOptions {
+            history_mode: Some(ThreadHistoryMode::Legacy),
+            ..StartThreadOptions::new(config.clone())
+        })
+        .await
+        .expect("start fork source thread");
+    qh_assert_empty_ceiling(&root);
+    let fork = manager
+        .spawn_legacy_subagent(
+            root.thread_id,
+            StartThreadOptions {
+                thread_extension_init: qh_init_with(qh_conflicting_policy()),
+                ..StartThreadOptions::new(config)
+            },
+        )
+        .await
+        .expect("fork legacy subagent");
+    qh_assert_empty_ceiling(&fork);
+    fork.thread.shutdown_and_wait().await.expect("shut down fork");
+    root.thread
+        .shutdown_and_wait()
+        .await
+        .expect("shut down fork source");
+}
