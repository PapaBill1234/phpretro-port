+// ---------------------------------------------------------------------------
+// Native text-host qualification (source-level, unbuilt here).
+//
+// The reviewed `text-only.patch` inserts an unconditional empty `ToolPolicy`
+// ceiling in the single production spawn funnel
+// (`ThreadManagerState::spawn_thread`), *after* any caller-supplied
+// `thread_extension_init` and before `Session::new` captures it. These tests
+// drive the real `ThreadManager` startup/resume/fork/internal entry points and
+// assert the manager-started session captured that empty ceiling, regardless of
+// the caller init supplied (absent, unrestricted, or conflicting). No turn is
+// submitted and no model/account/network call is made.
+// ---------------------------------------------------------------------------
+
+fn qh_init_with(policy: codex_extension_api::ToolPolicy) -> codex_extension_api::ExtensionDataInit {
+    let mut init = codex_extension_api::ExtensionDataInit::new();
+    init.insert(policy);
+    init
+}
+
+/// The ordinary (unrestricted) policy a caller could mistakenly expect to keep.
+fn qh_unrestricted_policy() -> codex_extension_api::ToolPolicy {
+    codex_extension_api::ToolPolicy::default()
+}
+
+/// A permissive policy that would relax the ceiling if it were not overwritten.
+fn qh_conflicting_policy() -> codex_extension_api::ToolPolicy {
+    codex_extension_api::ToolPolicy {
+        allowed_tools: Some(vec![codex_tools::ToolName::plain("exec_command")]),
+        require_managed_sandbox: false,
+        require_unified_exec: false,
+        expose_additional_permissions: true,
+    }
+}
+
+/// Asserts the session captured exactly the reviewed empty ceiling.
+fn qh_assert_empty_ceiling(new_thread: &NewThread) {
+    let policy = new_thread.thread.session.tool_policy.as_ref();
+    assert_eq!(
+        policy.allowed_tools.as_ref().map(Vec::len),
+        Some(0),
+        "manager-started session must capture an empty tool ceiling"
+    );
+    assert!(
+        !policy.require_managed_sandbox,
+        "ceiling must not require a managed sandbox"
+    );
+    assert!(
+        !policy.require_unified_exec,
+        "ceiling must not require unified exec"
+    );
+    assert!(
+        !policy.expose_additional_permissions,
+        "ceiling must not expose additional permissions"
+    );
+}
+
+/// Offline manager fixture: temp codex home, dummy auth, test environment manager.
+async fn qh_manager() -> (tempfile::TempDir, ThreadManager, Config) {
+    let temp_dir = tempdir().expect("tempdir");
+    let mut config = test_config().await;
+    config.codex_home = temp_dir.path().join("codex-home").abs();
+    config.cwd = config.codex_home.abs();
+    std::fs::create_dir_all(&config.codex_home).expect("create codex home");
+    let manager = ThreadManager::with_models_provider_and_home_for_tests(
+        CodexAuth::from_api_key("dummy"),
+        config.model_provider.clone(),
+        config.codex_home.to_path_buf(),
+        Arc::new(codex_exec_server::EnvironmentManager::default_for_tests()),
+    );
+    (temp_dir, manager, config)
+}
+
+#[tokio::test]
+async fn native_text_host_qualification_new_thread_without_init_captures_empty_ceiling() {
+    let (_temp_dir, manager, config) = qh_manager().await;
+    let started = manager
+        .start_thread(StartThreadOptions::new(config))
+        .await
+        .expect("start new thread without caller init");
+    qh_assert_empty_ceiling(&started);
+    started
+        .thread
+        .shutdown_and_wait()
+        .await
+        .expect("shut down new thread");
+}
+
+#[tokio::test]
+async fn native_text_host_qualification_overwrites_unrestricted_caller_init() {
+    let (_temp_dir, manager, config) = qh_manager().await;
+    let started = manager
+        .start_thread(StartThreadOptions {
+            thread_extension_init: qh_init_with(qh_unrestricted_policy()),
+            ..StartThreadOptions::new(config)
+        })
+        .await
+        .expect("start new thread with unrestricted caller init");
+    qh_assert_empty_ceiling(&started);
+    started
+        .thread
+        .shutdown_and_wait()
+        .await
+        .expect("shut down new thread");
+}
+
+#[tokio::test]
+async fn native_text_host_qualification_overwrites_conflicting_caller_init() {
+    let (_temp_dir, manager, config) = qh_manager().await;
+    let started = manager
+        .start_thread(StartThreadOptions {
+            thread_extension_init: qh_init_with(qh_conflicting_policy()),
+            ..StartThreadOptions::new(config)
+        })
+        .await
+        .expect("start new thread with conflicting caller init");
+    qh_assert_empty_ceiling(&started);
+    started
+        .thread
+        .shutdown_and_wait()
+        .await
+        .expect("shut down new thread");
+}
