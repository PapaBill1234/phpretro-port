diff --git a/packages/ui/src/components/shell/__e2e__/new-chat.test.tsx b/packages/ui/src/components/shell/__e2e__/new-chat.test.tsx
new file mode 100644
index 00000000..e75b3377
--- /dev/null
+++ b/packages/ui/src/components/shell/__e2e__/new-chat.test.tsx
@@ -0,0 +1,101 @@
+// @vitest-environment jsdom
+/**
+ * New chat from the shell overlay. The composer "+" menu's "New chat" runs the
+ * shared persisted-conversation creator (`handleNewConversation`) through
+ * {@link useNewChatAction}: one fresh conversation per gesture, the current
+ * thread preserved by the handler, and a create failure surfaces without
+ * throwing or losing the current chat.
+ */
+import {
+  cleanup,
+  fireEvent,
+  render,
+  screen,
+  waitFor,
+} from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+import { useNewChatAction } from "../useNewChatAction";
+
+afterEach(cleanup);
+
+function Harness({
+  startNewConversation,
+  onError,
+}: {
+  startNewConversation: (title?: string) => Promise<void>;
+  onError?: (err: unknown) => void;
+}) {
+  const { startNewChat, pending } = useNewChatAction({
+    startNewConversation,
+    onError,
+  });
+  return (
+    <div>
+      <button type="button" onClick={() => void startNewChat()}>
+        New chat
+      </button>
+      <span data-testid="pending">{pending ? "pending" : "idle"}</span>
+    </div>
+  );
+}
+
+describe("useNewChatAction (New chat menu)", () => {
+  it("activates one fresh conversation through the shared creator", async () => {
+    const startNewConversation = vi.fn(async () => {});
+    render(<Harness startNewConversation={startNewConversation} />);
+
+    fireEvent.click(screen.getByRole("button", { name: "New chat" }));
+
+    await waitFor(() => expect(startNewConversation).toHaveBeenCalledTimes(1));
+    // Pending clears once the create settles so the item re-enables.
+    await waitFor(() =>
+      expect(screen.getByTestId("pending").textContent).toBe("idle"),
+    );
+  });
+
+  it("ignores a double tap while the first create is still in flight", async () => {
+    let resolveCreate: () => void = () => {};
+    const startNewConversation = vi.fn(
+      () =>
+        new Promise<void>((resolve) => {
+          resolveCreate = resolve;
+        }),
+    );
+    render(<Harness startNewConversation={startNewConversation} />);
+
+    const button = screen.getByRole("button", { name: "New chat" });
+    fireEvent.click(button);
+    fireEvent.click(button);
+    // Same-frame taps must not enqueue a second conversation.
+    expect(startNewConversation).toHaveBeenCalledTimes(1);
+    await waitFor(() =>
+      expect(screen.getByTestId("pending").textContent).toBe("pending"),
+    );
+
+    resolveCreate();
+    await waitFor(() =>
+      expect(screen.getByTestId("pending").textContent).toBe("idle"),
+    );
+    expect(startNewConversation).toHaveBeenCalledTimes(1);
+  });
+
+  it("reports a create failure without throwing and releases pending", async () => {
+    const err = new Error("create failed");
+    const startNewConversation = vi.fn(async () => {
+      throw err;
+    });
+    const onError = vi.fn();
+    render(
+      <Harness startNewConversation={startNewConversation} onError={onError} />,
+    );
+
+    // The click handler must not reject into the gesture handler.
+    fireEvent.click(screen.getByRole("button", { name: "New chat" }));
+
+    await waitFor(() => expect(onError).toHaveBeenCalledWith(err));
+    await waitFor(() =>
+      expect(screen.getByTestId("pending").textContent).toBe("idle"),
+    );
+  });
+});
diff --git a/packages/ui/src/components/shell/useNewChatAction.ts b/packages/ui/src/components/shell/useNewChatAction.ts
new file mode 100644
index 00000000..8c5e2197
--- /dev/null
+++ b/packages/ui/src/components/shell/useNewChatAction.ts
@@ -0,0 +1,47 @@
+import * as React from "react";
+
+/**
+ * New chat activation for the shell overlay.
+ *
+ * Wraps the shared persisted-conversation creator (`handleNewConversation`,
+ * state/useChatCallbacks.ts) so the composer "+" menu can start a fresh
+ * conversation without deleting the current thread:
+ *
+ * - The helper only CREATES and ACTIVATES a new conversation; the previous
+ *   thread stays reachable (a non-empty conversation is always preserved, and
+ *   the cross-conversation message-ownership reset inside the handler keeps the
+ *   old context from leaking into the new one).
+ * - `pending` gates the menu item so a second tap cannot create a duplicate
+ *   conversation; a synchronous ref closes the same-frame double-tap gap before
+ *   React can paint the disabled item.
+ * - A create failure (the handler rolls itself back to the current chat) is
+ *   reported through `onError` and never thrown into the gesture handler.
+ */
+export function useNewChatAction(options: {
+  startNewConversation: (title?: string) => Promise<void>;
+  onError?: (err: unknown) => void;
+}): { startNewChat: () => Promise<void>; pending: boolean } {
+  const { startNewConversation, onError } = options;
+  const [pending, setPending] = React.useState(false);
+  const inFlightRef = React.useRef(false);
+  // Read the latest error sink through a ref so an inline logger closure does
+  // not churn `startNewChat`'s identity every render.
+  const onErrorRef = React.useRef(onError);
+  onErrorRef.current = onError;
+  const startNewChat = React.useCallback(async () => {
+    if (inFlightRef.current) return;
+    inFlightRef.current = true;
+    setPending(true);
+    try {
+      await startNewConversation();
+    } catch (err) {
+      // error-policy:J7 best-effort new chat — reported, never thrown into the
+      // gesture handler (matches the copy affordance above).
+      onErrorRef.current?.(err);
+    } finally {
+      inFlightRef.current = false;
+      setPending(false);
+    }
+  }, [startNewConversation]);
+  return { startNewChat, pending };
+}
