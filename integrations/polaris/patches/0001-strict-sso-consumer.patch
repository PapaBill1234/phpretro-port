+package com.eu.habbo;
+
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import com.eu.habbo.core.ConfigurationManager;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+class StrictSsoStartupPreflightTest {
+
+    @TempDir
+    Path configDirectory;
+
+    @Test
+    void fileFalseWithoutDatabaseOverrideContinuesAfterConfigurationLoad() throws Exception {
+        assertContinues(false, null);
+    }
+
+    @Test
+    void fileTrueWithoutDatabaseOverrideIsRejectedBeforeLaterPhases() throws IOException {
+        assertRejected(true, null);
+    }
+
+    @Test
+    void databaseFalseOverrideAllowsFileFalseAndFileTrue() throws Exception {
+        assertContinues(false, false);
+        assertContinues(true, false);
+    }
+
+    @Test
+    void databaseTrueOverrideRejectsFileFalseAndFileTrueBeforeLaterPhases() throws IOException {
+        assertRejected(false, true);
+        assertRejected(true, true);
+    }
+
+    private void assertContinues(boolean fileValue, Boolean databaseOverride) throws Exception {
+        ConfigurationManager configuration = configuration(fileValue);
+        AtomicInteger databaseLoads = new AtomicInteger();
+        AtomicInteger laterPhases = new AtomicInteger();
+
+        assertDoesNotThrow(() -> PolarisBootstrap.runSsoPreflightAndContinue(
+                configuration,
+                () -> applyDatabaseOverride(configuration, databaseLoads, databaseOverride),
+                () -> {
+                    laterPhases.incrementAndGet();
+                    return true;
+                }));
+
+        assertEquals(1, databaseLoads.get());
+        assertEquals(1, laterPhases.get());
+    }
+
+    private void assertRejected(boolean fileValue, Boolean databaseOverride) throws IOException {
+        ConfigurationManager configuration = configuration(fileValue);
+        AtomicInteger databaseLoads = new AtomicInteger();
+        AtomicInteger laterPhases = new AtomicInteger();
+
+        assertThrows(IllegalStateException.class, () -> PolarisBootstrap.runSsoPreflightAndContinue(
+                configuration,
+                () -> applyDatabaseOverride(configuration, databaseLoads, databaseOverride),
+                () -> {
+                    laterPhases.incrementAndGet();
+                    return true;
+                }));
+
+        assertEquals(1, databaseLoads.get());
+        assertEquals(0, laterPhases.get(), "preflight rejection must stop later startup work");
+    }
+
+    private ConfigurationManager configuration(boolean fileValue) throws IOException {
+        Path file = configDirectory.resolve("config-" + fileValue + "-" + System.nanoTime() + ".ini");
+        Files.writeString(file, "debug_sso=" + fileValue + System.lineSeparator());
+        return new ConfigurationManager(file.toString());
+    }
+
+    private static void applyDatabaseOverride(
+            ConfigurationManager configuration, AtomicInteger databaseLoads, Boolean databaseOverride) {
+        databaseLoads.incrementAndGet();
+        if (databaseOverride != null) {
+            configuration.update("debug_sso", databaseOverride.toString());
+        }
+    }
+}
