+++ b/Emulator/src/main/java/com/eu/habbo/habbohotel/users/SsoTicketConsumer.java
@@ -0,0 +1,61 @@
+package com.eu.habbo.habbohotel.users;
+
+import com.eu.habbo.Emulator;
+import java.nio.charset.StandardCharsets;
+import java.sql.Connection;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.util.OptionalInt;
+
+/** Atomic, one-use game SSO authentication. The caller must provide the packet bytes unchanged. */
+public final class SsoTicketConsumer {
+    private SsoTicketConsumer() {}
+
+    public static OptionalInt consume(String ticket) {
+        if (!isPrintableAscii(ticket)) {
+            return OptionalInt.empty();
+        }
+        byte[] bytes = ticket.getBytes(StandardCharsets.US_ASCII);
+        if (bytes.length < 1 || bytes.length > 128) return OptionalInt.empty();
+        try (Connection c = Emulator.getDatabase().getDataSource().getConnection()) {
+            c.setAutoCommit(false);
+            try {
+                int id = 0;
+                try (PreparedStatement lock = c.prepareStatement(
+                        "SELECT id FROM users WHERE CAST(auth_ticket AS BINARY) = ? "
+                        + "AND auth_ticket_expires_at IS NOT NULL AND auth_ticket_expires_at > CURRENT_TIMESTAMP FOR UPDATE")) {
+                    lock.setBytes(1, bytes);
+                    try (ResultSet rs = lock.executeQuery()) {
+                        if (!rs.next()) { c.rollback(); return OptionalInt.empty(); }
+                        id = rs.getInt(1);
+                        // Reject ambiguity under legacy case-insensitive ticket collations.
+                        if (rs.next()) { c.rollback(); return OptionalInt.empty(); }
+                    }
+                }
+                int changed;
+                try (PreparedStatement clear = c.prepareStatement(
+                        "UPDATE users SET auth_ticket = '', auth_ticket_expires_at = NULL "
+                        + "WHERE id = ? AND CAST(auth_ticket AS BINARY) = ? "
+                        + "AND auth_ticket_expires_at IS NOT NULL AND auth_ticket_expires_at > CURRENT_TIMESTAMP")) {
+                    clear.setInt(1, id); clear.setBytes(2, bytes); changed = clear.executeUpdate();
+                }
+                if (changed != 1) { c.rollback(); return OptionalInt.empty(); }
+                c.commit();
+                return OptionalInt.of(id);
+            } catch (SQLException e) {
+                try { c.rollback(); } catch (SQLException ignored) {}
+                return OptionalInt.empty();
+            }
+        } catch (SQLException e) { return OptionalInt.empty(); }
+    }
+
+    static boolean isPrintableAscii(String ticket) {
+        if (ticket == null || ticket.isEmpty() || ticket.length() > 128) return false;
+        for (int i = 0; i < ticket.length(); i++) {
+            char ch = ticket.charAt(i);
+            if (ch < 0x21 || ch > 0x7e) return false;
+        }
+        return true;
+    }
+}
