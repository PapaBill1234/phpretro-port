+class SsoTicketConsumerBehaviorTest {
+    @Test void rejectsUntrustedTicketFormsBeforeDatabaseAccess() {
+        assertFalse(SsoTicketConsumer.isPrintableAscii(null));
+        assertFalse(SsoTicketConsumer.isPrintableAscii(""));
+        assertFalse(SsoTicketConsumer.isPrintableAscii("ticket with space"));
+        assertFalse(SsoTicketConsumer.isPrintableAscii("ticket\t"));
+        assertFalse(SsoTicketConsumer.isPrintableAscii("é"));
