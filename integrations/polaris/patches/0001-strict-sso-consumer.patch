+package com.eu.habbo.networking.gameserver.auth;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+import com.eu.habbo.Emulator;
+import com.google.gson.JsonObject;
+import io.netty.channel.ChannelHandlerContext;
+import io.netty.channel.ChannelInboundHandlerAdapter;
+import io.netty.channel.embedded.EmbeddedChannel;
+import io.netty.handler.codec.http.*;
+import io.netty.util.ReferenceCountUtil;
+import java.nio.charset.StandardCharsets;
+import org.junit.jupiter.api.Test;
+import org.mockito.MockedStatic;
+
+class SessionEndpointsRetirementTest {
+    @Test
+    void everyGameTicketPresentationIsDeniedWithoutDatabaseOrOnlineAccess() {
+        try (MockedStatic<Emulator> emulator = mockStatic(Emulator.class)) {
+            emulator.when(Emulator::getDatabase).thenThrow(new AssertionError("database access"));
+            emulator.when(Emulator::getGameServer).thenThrow(new AssertionError("online access"));
+            for (String ticket : new String[]{"fresh-ticket", "expired-ticket", "consumed-ticket", "CASE-TICKET", " ticket ", "x".repeat(129), ""}) {
+                JsonObject body = new JsonObject();
+                body.addProperty("ssoTicket", ticket);
+                assertDenied(body);
+            }
+            assertDenied(null);
+            emulator.verifyNoInteractions();
+        }
+    }
+
+    private static void assertDenied(JsonObject body) {
+        EmbeddedChannel channel = new EmbeddedChannel(new ChannelInboundHandlerAdapter() {
+            @Override public void channelRead(ChannelHandlerContext ctx, Object message) {
+                try {
+                    SessionEndpoints.handleSsoToken(ctx, (FullHttpRequest) message, body, "127.0.0.1");
+                } finally {
+                    ReferenceCountUtil.release(message);
+                }
+            }
+        });
+        FullHttpResponse response = null;
+        try {
+            FullHttpRequest request = new DefaultFullHttpRequest(HttpVersion.HTTP_1_1, HttpMethod.POST, "/api/auth/sso-token");
+            request.headers().set(HttpHeaderNames.AUTHORIZATION, "Bearer fixture-invalid");
+            channel.writeInbound(request);
+            response = channel.readOutbound();
+            assertNotNull(response);
+            assertEquals(HttpResponseStatus.UNAUTHORIZED, response.status());
+            String payload = response.content().toString(StandardCharsets.UTF_8);
+            assertFalse(payload.contains("accessToken"));
+            assertFalse(payload.contains("accessTokenExpiresAt"));
+        } finally {
+            ReferenceCountUtil.release(response);
+            channel.finishAndReleaseAll();
+        }
+    }
+}
