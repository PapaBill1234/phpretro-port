+    @Test
+    void lateReleaseFromDisplacedClientCannotReleaseNewOwner() throws Exception {
+        var field = Emulator.class.getDeclaredField("crypto");
+        field.setAccessible(true);
+        Object previous = field.get(null);
+        field.set(null, new CryptoConfig(false, "", "", ""));
+        var channelA = new io.netty.channel.embedded.EmbeddedChannel();
+        var channelB = new io.netty.channel.embedded.EmbeddedChannel();
+        try {
+            GameClientManager manager = new GameClientManager();
+            GameClient a = new GameClient(channelA);
+            GameClient b = new GameClient(channelB);
+            assertEquals(null, manager.claimAuthenticatedSession(7, a));
+            assertEquals(a, manager.claimAuthenticatedSession(7, b));
+            manager.releaseAuthenticatedSession(7, a);
+            assertEquals(b, manager.getAuthenticatedClient(7));
+            assertEquals(1, manager.getAuthenticatedSessionCount(7));
+            manager.releaseAuthenticatedSession(7, b);
+            assertEquals(null, manager.getAuthenticatedClient(7));
+            assertEquals(0, manager.getAuthenticatedSessionCount(7));
+        } finally {
+            channelA.close(); channelB.close(); field.set(null, previous);
+        }
+    }
 }
